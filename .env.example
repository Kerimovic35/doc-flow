# Vorlage fuer die Umgebungsvariablen.
#
# ENTWICKLUNG: Diese Datei nach .env kopieren und Werte eintragen.
# PRODUKTION:  Die Werte in Coolify unter "Environment Variables" hinterlegen,
#              NICHT in einer Datei im Repository.
#
# .env selbst gehoert niemals ins Repository (siehe .gitignore).

# ------------------------------------------------------------
# Datenbank (Pflicht)
# ------------------------------------------------------------
# Entwicklung: lokale PostgreSQL-Instanz, getrennt von den Echtdaten.
# Produktion:  Die interne Verbindungszeichenkette der PostgreSQL-Ressource
#              aus Coolify. Sie zeigt auf den Dienstnamen im Docker-Netz,
#              nicht auf localhost.
DATABASE_URL="postgresql://docflow:PASSWORT_HIER@localhost:5432/docflow_dev?schema=public"

# Nur fuer Integrationstests (npm run test:int). Der Name MUSS docflow_test
# enthalten - die Testhilfe leert die Datenbank und weigert sich bei jedem
# anderen Namen.
TEST_DATABASE_URL="postgresql://docflow:PASSWORT_HIER@localhost:5432/docflow_test?schema=public"

# ------------------------------------------------------------
# Sitzungen (Pflicht)
# ------------------------------------------------------------
# Serverseitiger Zusatzschluessel ("Pepper") fuer das Hashen der
# Sitzungstokens. Erzeugen mit:
#   openssl rand -hex 32
# Ein Wechsel dieses Werts macht alle bestehenden Sitzungen ungueltig.
SESSION_SECRET="hier_einen_zufaelligen_wert_von_64_zeichen_eintragen"

# Lebensdauer einer Sitzung in Tagen.
SESSION_TTL_DAYS="30"

# ------------------------------------------------------------
# Betrieb
# ------------------------------------------------------------
NODE_ENV="development"

# Oeffentliche Adresse der Anwendung, ohne abschliessenden Schraegstrich.
#
# IN PRODUKTION PFLICHT UND SCHON ZUR BAUZEIT NOETIG. Next.js friert den Wert
# beim Standalone-Build in die Konfiguration ein; ein erst beim Start
# gesetzter Wert wird nie gelesen und jede Server Action scheitert mit einem
# CSRF-Fehler. In Coolify als "Available during build" markieren.
#
# Produktion: APP_ORIGIN="https://docflow.denkfabrik-digital.de"
# Entwicklung: leer lassen
APP_ORIGIN=""

# Zeitzone. Docker startet sonst in UTC, wodurch Fristen und Tagesgrenzen
# um Stunden verrutschen.
TZ="Europe/Berlin"

# ------------------------------------------------------------
# Dateiablage
# ------------------------------------------------------------
# Wurzelverzeichnis fuer Originaldokumente und abgeleitete Seitenbilder.
# Im Container ist /data/files voreingestellt und MUSS in Coolify als Volume
# eingehaengt sein - sonst sind alle Dokumente nach dem naechsten Deployment
# verloren. Der Start bricht ab, wenn das Verzeichnis nicht beschreibbar ist.
FILES_DIR="./data/files"

# ------------------------------------------------------------
# Hintergrundverarbeitung
# ------------------------------------------------------------
# Der Worker verarbeitet Seitenaufbereitung, Texterkennung und KI-Analyse.
# In Produktion laeuft er im selben Prozess wie die Anwendung.
# In der Entwicklung stattdessen "npm run worker" in einem zweiten Terminal
# starten - sonst legte jedes Neuladen des Entwicklungsservers eine weitere
# Schleife an. "true" erzwingt ihn auch in der Entwicklung.
WORKER_ENABLED=""

# ------------------------------------------------------------
# Texterkennung (OCR)
# ------------------------------------------------------------
# Vollstaendiger Pfad zu tesseract. Im Container bereits gesetzt.
# Windows (nach: winget install UB-Mannheim.TesseractOCR):
#   TESSERACT_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe"
TESSERACT_PATH=""

# ------------------------------------------------------------
# Kuenstliche Intelligenz
# ------------------------------------------------------------
# Schluessel fuer die Anthropic-API. Ausschliesslich serverseitig verwendet,
# niemals an den Browser ausgeliefert. Ohne Schluessel laeuft die Anwendung
# weiter, aber ohne Analyse und ohne Assistent.
ANTHROPIC_API_KEY=""

# Optionaler lokaler Anbieter (Ollama). Leer lassen, wenn nicht vorhanden.
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_BASE_URL=""

# ------------------------------------------------------------
# Backups
# ------------------------------------------------------------
BACKUP_DIR="./data/backups"

# Vollstaendiger Pfad zu pg_dump. Im Container bereits gesetzt.
# Lokal unter Windows noetig, weil der Installer das Programm nicht in den
# Suchpfad eintraegt.
# Windows: PG_DUMP_PATH="C:/Program Files/PostgreSQL/17/bin/pg_dump.exe"
PG_DUMP_PATH=""

BACKUP_HOUR="3"
BACKUP_MINUTE="30"
BACKUP_KEEP_DAYS="30"

# Optionale Verschluesselung der Abzuege mit age. Leer lassen = unverschluesselt.
# Empfaenger-Schluessel erzeugen mit: age-keygen
BACKUP_AGE_RECIPIENT=""

# ------------------------------------------------------------
# Erstzugang (nur in Produktion, nur beim allerersten Start)
# ------------------------------------------------------------
# Legt beim Serverstart ein Konto an - aber ausschliesslich dann, wenn die
# Benutzertabelle vollstaendig leer ist. Sobald ein Konto existiert, bleiben
# Benutzer unberuehrt.
#
# NACH DER ERSTEN ANMELDUNG BOOTSTRAP_PASSWORD WIEDER ENTFERNEN und das
# Passwort in der Anwendung aendern.
BOOTSTRAP_EMAIL=""
BOOTSTRAP_PASSWORD=""
BOOTSTRAP_NAME=""

# ------------------------------------------------------------
# Startdaten fuer die lokale Entwicklung (npm run db:seed)
# ------------------------------------------------------------
# SEED_EMAIL="..."
# SEED_NAME="..."
# SEED_PASSWORD="ein_starkes_startpasswort"
